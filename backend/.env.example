# Copy to backend/.env and adjust. Real environment variables override this file.

# dev | test | prod. Outside "dev", JWT_SECRET is required and must be 32+ characters.
APP_ENV=dev

# Signs access tokens (HS256). Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# If empty in dev, a random secret is used per process (sessions survive restarts via refresh).
JWT_SECRET=

ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# Set to true whenever the app is served over HTTPS (the refresh cookie is then Secure).
COOKIE_SECURE=false

# Create the 5 demo users (password below) and sample claims on first run.
SEED_DEMO_DATA=true
DEMO_PASSWORD=Password@123

# DATABASE_URL=sqlite:///./reimbursement.db
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Policy (amounts in INR)
# MAX_CLAIM_AMOUNT=100000.00
# RECEIPT_REQUIRED_ABOVE=1000.00
# MAX_EXPENSE_AGE_DAYS=90
